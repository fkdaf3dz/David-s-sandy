-- Dragging Logic
local dragging = false
local dragStart, startPos

toggleBtn.InputBegan:Connect(function(input)
    if not locked and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        dragging = true
        dragStart = input.Position
        startPos = toggleBtn.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and not locked and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        toggleBtn.Position = UDim2.new(
            startPos.X.Scale, 
            startPos.X.Offset + delta.X, 
            startPos.Y.Scale, 
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- Hold Detection
local holdTimer = 0
local holding = false

toggleBtn.MouseButton1Down:Connect(function()
    holding = true
    holdTimer = tick()
    task.spawn(function()
        while holding do
            if tick() - holdTimer >= 0.5 then
                lockMenu.Visible = true
                holding = false
                break
            end
            task.wait(0.05)
        end
    end)
end)

toggleBtn.MouseButton1Up:Connect(function()
    holding = false
end)

