end)

-- Rainbow Color Generator
local function getRainbowColor()
    return Color3.fromHSV((tick() % 4) / 4, 1, 1) 
end

-- Highly Optimized Ghost Trail Creation
local function createRainbowGhost(char)
    pcall(function()
        local clone = Instance.new("Model")
        clone.Name = "GhostAfterimage"
        clone.Parent = workspace
        
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local partClone = part:Clone()
                
                -- Maximum Performance Flags
                partClone.Anchored = true
                partClone.CanCollide = false
                partClone.CanQuery = false
                partClone.CanTouch = false
                partClone.CastShadow = false
                partClone.Massless = true
                
                -- Visual Settings
                partClone.Material = Enum.Material.Neon
                partClone.Color = getRainbowColor()
                partClone.Transparency = 0.35
                
                -- Cleanup Unnecessary Objects to save memory
                for _, child in ipairs(partClone:GetChildren()) do
                    if not child:IsA("SpecialMesh") then
                        child:Destroy()
                    end
                end
                
                partClone.Parent = clone
            end
        end
        
        -- Smooth Fade Out Loop
        task.spawn(function()
            local fadeSteps = 60
            local sleepTime = CONFIG.GhostDuration / fadeSteps
            local startTrans = 0.35
            
            for i = 1, fadeSteps do
                if not clone.Parent then break end
                task.wait(sleepTime)
                
                pcall(function()
                    local currentTrans = startTrans + ((1 - startTrans) * (i / fadeSteps))
                    for _, p in ipairs(clone:GetChildren()) do
                        if p:IsA("BasePart") then
                            p.Transparency = currentTrans
                        end
                    end
                end)
            end
            clone:Destroy()
        end)
    end)
end

-- Active Connection Reference
local sandevistanLoop

-- Sandevistan Toggle Switch Logic
local function toggleSandevistan()
    if lockMenu.Visible then return end
    
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    sandevistanActive = not sandevistanActive
    
    if sandevistanActive then
        -- Smooth Switch ON & Screen Tint ON
        animateUI(Color3.fromRGB(0, 255, 180), Color3.fromRGB(0, 0, 0), "SANDY: ON")
        btnStroke.Color = Color3.fromRGB(255, 255, 255)
        
        -- Tween the screen to the cyber-green tint
        TweenService:Create(sandyTint, tweenInfo, {
            TintColor = Color3.fromRGB(150, 255, 190), -- Cyber-green/cyan hue
            Contrast = 0.15,                           -- Slight contrast boost
            Saturation = -0.15                         -- Slightly desaturated for that anime feel
        }):Play()
        
        humanoid.WalkSpeed = CONFIG.ActiveSpeed
        humanoid.UseJumpPower = true
        humanoid.JumpPower = CONFIG.ActiveJump
        
        local timer = 0
        sandevistanLoop = RunService.RenderStepped:Connect(function(dt)
            if sandevistanActive and char and char.Parent and humanoid then
                local isMoving = humanoid.MoveDirection.Magnitude > 0
                local state = humanoid:GetState()
                local isAirborne = (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall)
                
                if isMoving or isAirborne then
                    timer = timer + dt
                    if timer >= CONFIG.SpawnRate then
                        timer = 0
                        createRainbowGhost(char)
                    end
                end
            else
                if sandevistanLoop then sandevistanLoop:Disconnect() end
            end
        end)
    else
        -- Smooth Switch OFF & Screen Tint OFF
        animateUI(Color3.fromRGB(20, 20, 30), Color3.fromRGB(255, 80, 80), "SANDY: OFF")
        btnStroke.Color = Color3.fromRGB(0, 255, 180)
        
        -- Tween the screen back to normal colors
        TweenService:Create(sandyTint, tweenInfo, {
            TintColor = Color3.fromRGB(255, 255, 255),
            Contrast = 0,
            Saturation = 0
        }):Play()
        
        humanoid.WalkSpeed = CONFIG.NormalSpeed
        humanoid.JumpPower = CONFIG.NormalJump
        
        if sandevistanLoop then 
            sandevistanLoop:Disconnect() 
            sandevistanLoop = nil
        end
    end
end

toggleBtn.MouseButton1Click:Connect(toggleSandevistan)

-- Auto-Reset on Respawn
player.CharacterAdded:Connect(function(newChar)
    sandevistanActive = false
    if sandevistanLoop then sandevistanLoop:Disconnect() end
    
    animateUI(Color3.fromRGB(20, 20, 30), Color3.fromRGB(255, 80, 80), "SANDY: OFF")
    btnStroke.Color = Color3.fromRGB(0, 255, 180)
    
    TweenService:Create(sandyTint, tweenInfo, {
        TintColor = Color3.fromRGB(255, 255, 255),
        Contrast = 0,
        Saturation = 0
    }):Play()
    
    task.wait(1)
    local hum = newChar:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = CONFIG.NormalSpeed
        hum.UseJumpPower = true
        hum.JumpPower = CONFIG.NormalJump
    end
end)

